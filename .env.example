# ============================================================================
# VARIÁVEIS DE AMBIENTE - BOT MEGA DEALS
# ============================================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA dê commit do .env no Git.
# ============================================================================

# ----------------------------------------------------------------------------
# SEGURANÇA DO PAINEL (OBRIGATÓRIO)
# ----------------------------------------------------------------------------
# Senha de acesso ao dashboard web (mínimo recomendado: 12 caracteres).
PAINEL_PASSWORD=sua_senha_forte_aqui

# Chave secreta para criptografia de sessão do Flask.
# Gere uma nova com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=sua_chave_secreta_aqui

# ----------------------------------------------------------------------------
# TELEGRAM
# ----------------------------------------------------------------------------
# Token do bot criado no @BotFather. Exemplo de formato: 1234567890:ABCdef...
TELEGRAM_BOT_TOKEN=seu_token_aqui

# IDs de canais e grupos (separados por vírgula). Exemplo: -1001234567890,-1009876543210
TELEGRAM_CANAIS=
TELEGRAM_GRUPOS=

# ----------------------------------------------------------------------------
# RSS FEED
# ----------------------------------------------------------------------------
# URL do feed RSS de ofertas. Padrão: Promobit
RSS_FEED_URL=https://www.promobit.com.br/feed/

# ----------------------------------------------------------------------------
# AFILIADOS
# ----------------------------------------------------------------------------
# Tag de afiliado da Amazon (ex: seu-codigo-20)
AFFILIATE_TAG_AMAZON=

# Tag/UTM de afiliado do Mercado Livre
AFFILIATE_TAG_OUTROS=

# ----------------------------------------------------------------------------
# AMBIENTE
# ----------------------------------------------------------------------------
# Defina como 'production' para habilitar cookies seguros em HTTPS
FLASK_ENV=development
